{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapsShot",
  "version": "0.1.9",
  "identifier": "app.capshot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}